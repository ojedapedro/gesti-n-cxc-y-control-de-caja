{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Daily box income or recorded sale.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "clientName": { "type": "string" },
        "concept": { "type": "string" },
        "amountBs": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "amountUsd": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Bolivares", "Dolares Efectivo", "Zelle", "Cuentas por Cobrar (CXC)"] },
        "type": { "type": "string", "enum": ["income", "sale", "withdrawal"] },
        "isCXC": { "type": "boolean" },
        "cxcBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "amountUsd", "type"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expenses.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "amountBs": { "type": "number" },
        "amountUsd": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "category", "amountUsd"]
    },
    "CXCAccount": {
      "title": "Cuentas por Cobrar (CXC) Account",
      "description": "Outstanding balance per client (CXC).",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "totalBalance": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "totalBalance"]
    },
    "CXCPayment": {
      "title": "Cuentas por Cobrar (CXC) Payment",
      "description": "Payments made towards an outstanding Cuentas por Cobrar (CXC) balance.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "amountUsd": { "type": "number" },
        "concept": { "type": "string" },
        "rubroName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "date", "amountUsd"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Support for cash withdrawals.",
      "type": "object",
      "properties": {
        "receiptNumber": { "type": "string" },
        "amountUsd": { "type": "number" },
        "recipient": { "type": "string" },
        "concept": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["receiptNumber", "amountUsd", "recipient", "date"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings like exchange rates.",
      "type": "object",
      "properties": {
        "exchangeRate": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["exchangeRate"]
    },
    "Seller": {
      "title": "Seller",
      "description": "Vendedor profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" },
        "commissionPercentage": { "type": "number" },
        "rubros": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "commissionPercentage": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "region", "commissionPercentage"]
    },
    "ExchangeRateEntry": {
      "title": "Exchange Rate History Entry",
      "description": "Historical record of currency exchange rates by date.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "rate": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "rate"]
    }
  },
  "firestore": {
    "/transactions": {
      "schema": "Transaction",
      "description": "Main ledger for daily incomes and sales."
    },
    "/expenses": {
      "schema": "Expense",
      "description": "Business expenses tracking."
    },
    "/cxc_accounts": {
      "schema": "CXCAccount",
      "description": "Summary of outstanding balances by client."
    },
    "/cxc_accounts/{clientId}/payments": {
      "schema": "CXCPayment",
      "description": "History of payments for a specific client."
    },
    "/sellers": {
      "schema": "Seller",
      "description": "List of authorized sellers for credit sales."
    },
    "/receipts": {
      "schema": "Receipt",
      "description": "Withdrawal receipts."
    },
    "/settings": {
      "schema": "Settings",
      "description": "Global configuration."
    },
    "/settings/goals": {
      "schema": { "type": "object" },
      "description": "Monthly sales and income goals target values keyed by YYYY-MM."
    },
    "/exchange_rates": {
      "schema": "ExchangeRateEntry",
      "description": "Historical exchange rates record."
    }
  }
}
